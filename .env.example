# Docker Compose deployment settings. Copy to .env; never commit secrets.
# Use an existing PostgreSQL database. Compose does not create/migrate/seed it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=
CLIENT_URL=https://medirehab.example.com
# Browser-reachable URL, baked into the frontend during its Docker build.
NEXT_PUBLIC_API_URL=https://api.medirehab.example.com/api
